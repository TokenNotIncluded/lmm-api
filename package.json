{
  "name": "api.lmm.best",
  "version": "0.1.6",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:go": "cd apps/lmm-extensions && go run ./cmd/extensions",
    "dev:web": "bun run --filter @lmm/web dev",
    "build:go": "mkdir -p apps/lmm-extensions/out && cd apps/lmm-extensions && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o out/lmm-extensions ./cmd/extensions",
    "build:web": "bun run --filter @lmm/web build",
    "test:go": "cd apps/lmm-extensions && go test -race ./... -count=1",
    "test:web": "bun run --filter @lmm/web test",
    "format:go": "cd apps/lmm-extensions && go fmt ./...",
    "format:web": "bun run --filter @lmm/web format",
    "format-check:go": "bash scripts/check-go-format.sh apps/lmm-extensions",
    "format-check:web": "bun run --filter @lmm/web format:check",
    "lint:go": "cd apps/lmm-extensions && go vet ./...",
    "lint:web": "bun run --filter @lmm/web lint",
    "typecheck:go": "cd apps/lmm-extensions && go test -run '^$' ./...",
    "typecheck:web": "bun run --filter @lmm/web typecheck",
    "waffo:pancake:smoke": "node scripts/waffo-pancake-smoke.mjs",
    "dev:core": "cd apps/lmm-core && cargo run --locked",
    "build:core": "cd apps/lmm-core && cargo build --locked --release",
    "test:core": "cd apps/lmm-core && cargo test --locked --all-targets",
    "format:core": "cd apps/lmm-core && cargo fmt --all",
    "format-check:core": "cd apps/lmm-core && cargo fmt --all --check",
    "lint:core": "cd apps/lmm-core && cargo clippy --locked --all-targets -- -D warnings",
    "typecheck:core": "cd apps/lmm-core && cargo check --locked --all-targets",
    "dev:extensions": "bun run dev:go",
    "build:extensions": "bun run build:go",
    "test:extensions": "bun run test:go",
    "format:extensions": "bun run format:go",
    "format-check:extensions": "bun run format-check:go",
    "lint:extensions": "bun run lint:go"
  },
  "overrides": {
    "brace-expansion": "2.1.1",
    "dompurify": "3.4.16",
    "fast-uri": "3.1.2",
    "hono": "4.12.22",
    "ip-address": "10.2.0",
    "js-cookie": "3.0.7",
    "mermaid": "11.15.0",
    "minimist": "1.2.8",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@waffo/pancake-ts": "0.20.0"
  }
}
