{
  "name": "api.lmm.best",
  "version": "0.1.6",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:go": "cd apps/api-go && go run .",
    "dev:web": "bun run --filter @lmm/web dev",
    "dev:rust": "cargo run --manifest-path apps/api-rust/Cargo.toml --locked --package lmm-api-rs",
    "build:go": "mkdir -p apps/api-go/out && cd apps/api-go && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o out/lmm-api-go . && rm -f out/.lmm-api.next && ln -s lmm-api-go out/.lmm-api.next && mv -Tf out/.lmm-api.next out/lmm-api",
    "build:web": "bun run --filter @lmm/web build",
    "build:rust": "cargo build --manifest-path apps/api-rust/Cargo.toml --locked --release --package lmm-api-rs",
    "test:go": "cd apps/api-go && go test ./...",
    "test:web": "bun run --filter @lmm/web test",
    "test:rust": "cargo test --manifest-path apps/api-rust/Cargo.toml --locked --workspace --all-targets --all-features",
    "format:go": "cd apps/api-go && go fmt ./...",
    "format:web": "bun run --filter @lmm/web format",
    "format:rust": "cargo fmt --manifest-path apps/api-rust/Cargo.toml --all",
    "format-check:go": "test -z \"$(gofmt -l apps/api-go)\"",
    "format-check:web": "bun run --filter @lmm/web format:check",
    "format-check:rust": "cargo fmt --manifest-path apps/api-rust/Cargo.toml --all --check",
    "lint:go": "cd apps/api-go && go vet ./...",
    "lint:web": "bun run --filter @lmm/web lint",
    "lint:rust": "cargo clippy --manifest-path apps/api-rust/Cargo.toml --locked --workspace --all-targets --all-features -- -D warnings",
    "typecheck:go": "cd apps/api-go && go test -run '^$' ./...",
    "typecheck:web": "bun run --filter @lmm/web typecheck",
    "typecheck:rust": "cargo check --manifest-path apps/api-rust/Cargo.toml --locked --workspace --all-targets --all-features",
    "waffo:pancake:smoke": "node scripts/waffo-pancake-smoke.mjs"
  },
  "overrides": {
    "brace-expansion": "2.1.1",
    "dompurify": "3.4.12",
    "fast-uri": "3.1.2",
    "hono": "4.12.22",
    "ip-address": "10.2.0",
    "js-cookie": "3.0.7",
    "mermaid": "11.15.0",
    "minimist": "1.2.8",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@waffo/pancake-ts": "0.9.0"
  }
}
