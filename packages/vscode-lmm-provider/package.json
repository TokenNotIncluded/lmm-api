{
  "name": "lmm-copilot-provider",
  "displayName": "LMM for Copilot",
  "icon": "assets/icon.png",
  "description": "Use LMM models in VS Code Chat with secure browser OAuth sign-in.",
  "version": "0.1.3",
  "publisher": "LIghtJUNction",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokenNotIncluded/lmm-api.git",
    "directory": "packages/vscode-lmm-provider"
  },
  "homepage": "https://api.lmm.best",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguageModelChatProvider:lmm"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lmm.signIn",
        "title": "LMM: Sign In"
      },
      {
        "command": "lmm.signOut",
        "title": "LMM: Sign Out"
      },
      {
        "command": "lmm.refreshModels",
        "title": "LMM: Refresh Models"
      },
      {
        "command": "lmm.refreshAccount",
        "title": "LMM: Refresh Balance"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "lmm",
        "displayName": "LMM",
        "managementCommand": "lmm.signIn"
      }
    ],
    "configuration": {
      "title": "LMM",
      "properties": {
        "lmm.maxInputTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "maximum": 2000000,
          "description": "Optional input budget cap for all models. When not explicitly set, exact models.dev reference limits or lmm.modelLimits are used, reserving the output budget. Unknown models fall back to this default estimate."
        },
        "lmm.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 1,
          "maximum": 131072,
          "description": "Output budget sent to each model. Set at or below your model's supported limit."
        },
        "lmm.modelLimits": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": ["contextWindow", "maxOutputTokens"],
            "additionalProperties": false,
            "properties": {
              "contextWindow": { "type": "integer", "minimum": 2, "maximum": 2000000 },
              "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 2000000 }
            }
          },
          "description": "Verified model-specific limits keyed by exact LMM wire model ID or upstream ID. Wire IDs take priority for group-specific gateway limits. Overrides supersede the bundled models.dev reference snapshot. Output must be less than context."
        },
        "lmm.toolModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Exact canonical LMM wire IDs or upstream model IDs verified to support OpenAI function calling. Wire IDs enable a specific group route; upstream IDs enable every group for that ID. Empty by default."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "test:host": "bash scripts/test-host.sh"
  },
  "overrides": {
    "@azure/msal-node": "7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.9.3"
  },
  "preview": true
}
