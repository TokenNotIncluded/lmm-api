# Maintainer: LMM API maintainers

pkgname=lmm-api-go-bin
pkgver="${LMM_API_PKGVER:-0.1.6}"
pkgrel="${LMM_API_PKGREL:-1}"
pkgdesc='LMM API Go backend, native CLI, systemd service, and web frontend (local build)'
arch=('x86_64')
url='https://github.com/LIghtJUNction/api.lmm.best'
license=('AGPL-3.0-only')
depends=('ca-certificates' 'coreutils' 'libarchive' 'pacman' 'paru' 'sudo' 'systemd' 'tzdata' 'util-linux')
optdepends=(
  'postgresql: production database'
  'valkey: cache, rate limiting, and login sessions'
)
source "${startdir:?}/lmm-api-cli-phase.sh"
lmm_go_provider_apply_metadata "$pkgver" "$pkgname" \
  'lmm-api-go' 'lmm-api-go-bin' 'lmm-api-go-git'
backup=('etc/lmm-api-go/lmm-api-go.env')
options=('!strip')
source=(
  lmm-api-go
  lmm-api-cli-phase.sh
  frontend-dist.tar
  lmm-api.service
  lmm-api-go.env
  lmm-api-operator.sysusers
  lmm-api-operator.tmpfiles
  lmm-api-operator.sudoers
  REVISION
  LICENSE
  NOTICE
  THIRD-PARTY-LICENSES.md
  nginx-http-map.conf
  nginx-locations.conf
  nginx-mime.types
  nginx-new-api.conf
  nginx-region-policy.conf
  geoip2-country-update.service
  geoip2-country-update.timer
)
sha256sums=('SKIP' 'aec051c3b12a86a228f92651865e16b309f36a9071dcf02e28edd9e18d3b4e19' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  install -d -m0755 "${srcdir}/frontend-dist"
  tar -xf "${srcdir}/frontend-dist.tar" -C "${srcdir}/frontend-dist"
}

package() {
  local file

  install -Dm0755 "${srcdir}/lmm-api-go" "${pkgdir}/usr/bin/lmm-api-go"
  lmm_go_provider_assert_payload "$pkgdir"
  install -Dm0644 "${srcdir}/lmm-api.service" \
    "${pkgdir}/usr/lib/systemd/system/lmm-api.service"
  install -Dm0644 "${srcdir}/lmm-api-operator.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/lmm-api-operator.conf"
  install -Dm0644 "${srcdir}/lmm-api-operator.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/lmm-api-operator.conf"
  install -Dm0440 "${srcdir}/lmm-api-operator.sudoers" \
    "${pkgdir}/etc/sudoers.d/lmm-api-operator"
  install -Dm0644 "${srcdir}/geoip2-country-update.service" \
    "${pkgdir}/usr/lib/systemd/system/geoip2-country-update.service"
  install -Dm0644 "${srcdir}/geoip2-country-update.timer" \
    "${pkgdir}/usr/lib/systemd/system/geoip2-country-update.timer"

  install -d -m0755 "${pkgdir}/usr/share/lmm-api-go/edge-policy/nginx"
  for file in http-map.conf mime.types new-api.conf; do
    install -Dm0644 "${srcdir}/nginx-${file}" \
      "${pkgdir}/usr/share/lmm-api-go/edge-policy/nginx/${file}"
  done
  install -Dm0644 "${srcdir}/nginx-locations.conf" \
    "${pkgdir}/usr/share/lmm-api-go/edge-policy/nginx/lmm-api-locations.conf"
  install -Dm0644 "${srcdir}/nginx-region-policy.conf" \
    "${pkgdir}/usr/share/lmm-api-go/edge-policy/nginx/lmm-api-region-policy.conf"
  install -Dm0644 "${srcdir}/geoip2-country-update.service" \
    "${pkgdir}/usr/share/lmm-api-go/edge-policy/geoip2-country-update.service"
  install -Dm0644 "${srcdir}/geoip2-country-update.timer" \
    "${pkgdir}/usr/share/lmm-api-go/edge-policy/geoip2-country-update.timer"
  install -d -m0700 "${pkgdir}/etc/lmm-api-go"
  install -Dm0600 "${srcdir}/lmm-api-go.env" \
    "${pkgdir}/etc/lmm-api-go/lmm-api-go.env"

  install -d -m0755 "${pkgdir}/usr/share/lmm-api-go/frontend-dist"
  cp -R --no-preserve=ownership,mode,timestamps -- "${srcdir}/frontend-dist/." \
    "${pkgdir}/usr/share/lmm-api-go/frontend-dist/"
  find "${pkgdir}/usr/share/lmm-api-go/frontend-dist" -type d -exec chmod 0755 {} +
  find "${pkgdir}/usr/share/lmm-api-go/frontend-dist" -type f -exec chmod 0644 {} +

  for file in LICENSE NOTICE THIRD-PARTY-LICENSES.md; do
    install -Dm0644 "${srcdir}/${file}" "${pkgdir}/usr/share/licenses/${pkgname}/${file}"
  done
  install -Dm0644 "${srcdir}/REVISION" "${pkgdir}/usr/share/doc/${pkgname}/REVISION"
}
