types {
    text/html                             html htm;
    text/css                              css;
    text/plain                            txt;
    application/javascript               js mjs;
    application/json                     json map;
    application/manifest+json            webmanifest;
    application/wasm                     wasm;
    application/xml                      xml;
    image/avif                            avif;
    image/gif                             gif;
    image/jpeg                            jpeg jpg;
    image/png                             png;
    image/svg+xml                         svg svgz;
    image/webp                            webp;
    image/x-icon                          ico;
    font/otf                              otf;
    font/ttf                              ttf;
    font/woff                             woff;
    font/woff2                            woff2;
}
