#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly gate_header=$'method\tpath\tsource_state\tcompile_state\tmount_state\tdifferential_state\tapproval_state\tproduction_owner\tgate_state\tevidence'
readonly frozen_header=$'method\tpath\tauth_scope'
readonly max_control_bytes=$((4 * 1024 * 1024))
readonly max_evidence_bytes=$((64 * 1024))

die() { printf 'validate-route-gate: %s\n' "$*" >&2; exit 1; }
usage() {
  printf '%s\n' \
    'Usage: validate-route-gate --mode source|activate --snapshot-dir DIR --assets-manifest PATH --assets-manifest-sha256 SHA256 --gate PATH --frozen-contract PATH [--evidence-root DIR] [--revision REV --migration-compatibility PATH]'
}
safe_reference() {
  [[ $1 != /* && $1 != *'..'* && $1 != ./* && $1 != */./* && $1 != */. && \
    $1 != *'//' && $1 != *$'\n'* && $1 != *$'\r'* ]]
}
sha256_of() {
  local value
  value=$(sha256sum -- "$1")
  printf '%s\n' "${value%% *}"
}
validate_directory() {
  local directory=$1 label=$2 owner mode canonical
  [[ ! ${validated_directory[$directory]+x} ]] || return 0
  [[ -d $directory && ! -L $directory ]] || die "$label must be a regular non-symlink directory"
  canonical=$(realpath -e -- "$directory") || die "$label cannot be resolved"
  [[ $canonical == "$directory" ]] || die "$label must use its canonical path"
  read -r owner mode < <(stat -c '%u %a' -- "$directory")
  [[ $owner == "$expected_owner" ]] || die "$label has an unsafe owner"
  (( (8#$mode & 8#022) == 0 )) || die "$label is group/world writable"
  validated_directory[$directory]=1
}
validate_parent_chain() {
  local path=$1 root=$2 label=$3 directory
  directory=$(dirname -- "$path")
  while :; do
    validate_directory "$directory" "$label parent"
    [[ $directory == "$root" ]] && break
    [[ $directory == "$root"/* ]] || die "$label escapes its controlling directory"
    directory=$(dirname -- "$directory")
  done
}
snapshot_input() {
  local source=$1 control_root=$2 destination_name=$3 limit=$4 label=$5 expected_sha=${6:-}
  local owner mode size destination actual_sha
  [[ $source == "$control_root"/* ]] || die "$label escapes its controlling directory"
  validate_parent_chain "$source" "$control_root" "$label"
  destination="$snapshot_dir/$destination_name"
  [[ ! -e $destination && ! -L $destination ]] || die "snapshot destination already exists: $destination_name"
  cp --no-dereference --preserve=mode,ownership -- "$source" "$destination" || die "$label snapshot failed"
  [[ -f $destination && ! -L $destination ]] || die "$label snapshot is not a regular file"
  read -r owner mode size < <(stat -c '%u %a %s' -- "$destination")
  [[ $owner == "$expected_owner" ]] || die "$label snapshot has an unsafe owner"
  (( (8#$mode & 8#022) == 0 )) || die "$label snapshot is group/world writable"
  ((size > 0 && size <= limit)) || die "$label snapshot is empty or exceeds its size limit"
  if [[ -n $expected_sha ]]; then
    actual_sha=$(sha256_of "$destination")
    [[ $expected_sha =~ ^[0-9a-f]{64}$ && $actual_sha == "$expected_sha" ]] || \
      die "$label snapshot checksum mismatch"
  fi
  chmod 0600 -- "$destination"
  SNAPSHOT_RESULT=$destination
}
resolve_evidence() {
  local root=$1 path=$2
  safe_reference "$path" || die "evidence path is unsafe: $path"
  printf '%s\n' "$root/$path"
}

mode=
snapshot_dir=
gate=
frozen_contract=
assets_manifest=
assets_manifest_sha256=
evidence_root=
revision=
migration_compatibility=
while (($#)); do
  case $1 in
    --mode) (($# >= 2)) || die '--mode requires source or activate'; mode=$2; shift 2 ;;
    --snapshot-dir) (($# >= 2)) || die '--snapshot-dir requires a directory'; snapshot_dir=$2; shift 2 ;;
    --assets-manifest) (($# >= 2)) || die '--assets-manifest requires a path'; assets_manifest=$2; shift 2 ;;
    --assets-manifest-sha256)
      (($# >= 2)) || die '--assets-manifest-sha256 requires a digest'
      assets_manifest_sha256=$2
      shift 2
      ;;
    --gate) (($# >= 2)) || die '--gate requires a path'; gate=$2; shift 2 ;;
    --frozen-contract) (($# >= 2)) || die '--frozen-contract requires a path'; frozen_contract=$2; shift 2 ;;
    --frozen-contract-sha256) (($# >= 2)) || die '--frozen-contract-sha256 requires a digest'; shift 2 ;;
    --evidence-root) (($# >= 2)) || die '--evidence-root requires a directory'; evidence_root=$2; shift 2 ;;
    --revision) (($# >= 2)) || die '--revision requires a release revision'; revision=$2; shift 2 ;;
    --migration-compatibility)
      (($# >= 2)) || die '--migration-compatibility requires a path'
      migration_compatibility=$2
      shift 2
      ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ $mode == source || $mode == activate ]] || die '--mode must be source or activate'
for command in awk chmod cp diff find jq realpath sed sha256sum stat; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done
expected_owner=$EUID
declare -A validated_directory=()
if [[ $mode == activate && ${LMM_ROUTE_GATE_TEST_MODE:-0} != 1 ]]; then
  [[ $EUID -eq 0 ]] || die 'activation validation requires root'
  expected_owner=0
fi
[[ -n $snapshot_dir && $snapshot_dir == /* ]] || die 'snapshot directory must be an absolute path'
validate_directory "$snapshot_dir" 'snapshot directory'
validate_directory "$(dirname -- "$snapshot_dir")" 'snapshot controlling directory'
[[ $(stat -c '%a' -- "$snapshot_dir") == 700 ]] || die 'snapshot directory must be private mode 0700'
[[ -z $(find "$snapshot_dir" -mindepth 1 -maxdepth 1 -print -quit) ]] || die 'snapshot directory must be empty'

[[ -n $assets_manifest && $assets_manifest == /* ]] || die 'asset manifest must be an absolute path'
[[ $assets_manifest_sha256 =~ ^[0-9a-f]{64}$ ]] || die 'authoritative asset manifest checksum is invalid'
manifest_root=$(dirname -- "$assets_manifest")
validate_directory "$manifest_root" 'asset manifest controlling directory'
if [[ -n ${LMM_ROUTE_GATE_TEST_BEFORE_MANIFEST_COPY_READY_FILE:-} ]]; then
  [[ $mode == source && ${LMM_ROUTE_GATE_TEST_MODE:-0} == 1 ]] || die 'manifest synchronization hook is test-source-only'
  : >"$LMM_ROUTE_GATE_TEST_BEFORE_MANIFEST_COPY_READY_FILE"
  for _ in {1..1000}; do
    [[ -e ${LMM_ROUTE_GATE_TEST_BEFORE_MANIFEST_COPY_RELEASE_FILE:-} ]] && break
    sleep 0.01
  done
  [[ -e ${LMM_ROUTE_GATE_TEST_BEFORE_MANIFEST_COPY_RELEASE_FILE:-} ]] || die 'manifest synchronization hook timed out'
fi
snapshot_input "$assets_manifest" "$manifest_root" assets.sha256 "$max_evidence_bytes" \
  'route-gate asset manifest' "$assets_manifest_sha256"
assets_manifest_snapshot=$SNAPSHOT_RESULT
declare -A asset_sha=()
while read -r digest name; do
  [[ $digest =~ ^[0-9a-f]{64}$ ]] || die 'route-gate asset manifest contains an invalid checksum'
  [[ $name =~ ^(migration-gate.tsv|validate-route-gate|migration-compatibility.env|frozen-route-auth.tsv)$ ]] || \
    die 'route-gate asset manifest contains an unexpected path'
  [[ ! ${asset_sha[$name]+x} ]] || die 'route-gate asset manifest contains a duplicate path'
  asset_sha[$name]=$digest
done <"$assets_manifest_snapshot"
[[ ${#asset_sha[@]} -eq 4 ]] || die 'route-gate asset manifest must contain exactly four assets'

if [[ -n ${LMM_ROUTE_GATE_TEST_BEFORE_ASSET_COPY_READY_FILE:-} ]]; then
  [[ $mode == source && ${LMM_ROUTE_GATE_TEST_MODE:-0} == 1 ]] || die 'asset synchronization hook is test-source-only'
  : >"$LMM_ROUTE_GATE_TEST_BEFORE_ASSET_COPY_READY_FILE"
  for _ in {1..1000}; do
    [[ -e ${LMM_ROUTE_GATE_TEST_BEFORE_ASSET_COPY_RELEASE_FILE:-} ]] && break
    sleep 0.01
  done
  [[ -e ${LMM_ROUTE_GATE_TEST_BEFORE_ASSET_COPY_RELEASE_FILE:-} ]] || die 'asset synchronization hook timed out'
fi
gate_root=$(dirname -- "$gate")
frozen_root=$(dirname -- "$frozen_contract")
validate_directory "$gate_root" 'route gate controlling directory'
validate_directory "$frozen_root" 'frozen contract controlling directory'
snapshot_input "$gate" "$gate_root" gate.tsv "$max_control_bytes" 'route gate' "${asset_sha[migration-gate.tsv]}"
gate_snapshot=$SNAPSHOT_RESULT
snapshot_input "$frozen_contract" "$frozen_root" frozen.tsv "$max_control_bytes" 'frozen route/auth contract' \
  "${asset_sha[frozen-route-auth.tsv]}"
frozen_snapshot=$SNAPSHOT_RESULT
[[ $(sed -n '1{s/\r$//;p;q;}' -- "$gate_snapshot") == "$gate_header" ]] || die 'migration-gate.tsv header is invalid'
[[ $(sed -n '1{s/\r$//;p;q;}' -- "$frozen_snapshot") == "$frozen_header" ]] || \
  die 'frozen route/auth contract header is invalid'

awk -F '\t' '
  NR == 1 { next }
  NF != 3 { printf "frozen contract line %d: expected 3 fields\n", NR > "/dev/stderr"; failed=1; next }
  $1 !~ /^(GET|POST|PUT|DELETE|PATCH)$/ { printf "frozen contract line %d: invalid method\n", NR > "/dev/stderr"; failed=1 }
  $2 !~ /^\// { printf "frozen contract line %d: invalid path\n", NR > "/dev/stderr"; failed=1 }
  $3 !~ /^(public|webhook|token|public-or-user|admin|root|user|user-or-token)$/ { printf "frozen contract line %d: invalid auth scope\n", NR > "/dev/stderr"; failed=1 }
  { key=$1 "\t" $2; if (seen[key]++) { printf "frozen contract line %d: duplicate route\n", NR > "/dev/stderr"; failed=1 } }
  END { if (NR != 354) { printf "expected 353 frozen routes, got %d\n", NR - 1 > "/dev/stderr"; failed=1 }; exit failed }
' < <(sed 's/\r$//' -- "$frozen_snapshot") || die 'frozen route/auth contract is invalid'

awk -F '\t' -v mode="$mode" '
  function reject(message) { printf "gate line %d: %s\n", NR, message > "/dev/stderr"; failed=1 }
  NR == 1 { next }
  {
    if (NF != 10) { reject("expected 10 tab-separated fields, got " NF); next }
    if ($1 !~ /^(GET|POST|PUT|DELETE|PATCH)$/ || $2 !~ /^\//) reject("invalid route key")
    if ($3 !~ /^(absent|present)$/ || $4 !~ /^(not-applicable|unverified|verified)$/ ||
        $5 !~ /^(unmounted|mounted)$/ || $6 !~ /^(not-applicable|unverified|verified|blocked-sol-stop)$/ ||
        $7 !~ /^(not-applicable|pending-independent-approval|approved)$/ || $8 !~ /^(go|rs)$/ ||
        $9 !~ /^(legacy-go|mounted-unverified|candidate-pending-independent-approval|blocked-sol-stop|verified-approved)$/)
      reject("invalid gate field value")
    key=$1 "\t" $2; if (seen[key]++) reject("duplicate route key " key)
    eligible=($3 == "present" && $4 == "verified" && $5 == "mounted" && $6 == "verified" &&
      $7 == "approved" && $9 == "verified-approved")
    if ($8 == "rs" && !eligible) reject("Rust ownership requires independently verified-approved eligibility")
    if ($9 == "legacy-go" && !($3 == "absent" && $4 == "not-applicable" && $5 == "unmounted" && $6 == "not-applicable" && $7 == "not-applicable" && $8 == "go")) reject("legacy-go state mismatch")
    if ($9 == "mounted-unverified" && !($3 == "present" && $4 == "unverified" && $5 == "mounted" && $6 == "unverified" && $7 == "not-applicable" && $8 == "go")) reject("mounted-unverified state mismatch")
    if ($9 == "candidate-pending-independent-approval" && !($3 == "present" && $4 == "unverified" && $5 == "mounted" && $6 == "unverified" && $7 == "pending-independent-approval" && $8 == "go")) reject("pending candidate state mismatch")
    if ($9 == "blocked-sol-stop" && !($3 == "present" && $4 == "unverified" && $5 == "mounted" && $6 == "blocked-sol-stop" && $7 == "not-applicable" && $8 == "go")) reject("blocked route state mismatch")
    if ($9 == "verified-approved" && !eligible) reject("verified-approved state mismatch")
    if (mode == "activate" && !($8 == "rs" && eligible)) reject("activation requires every route to be independently verified-approved and Rust-owned")
  }
  END { if (NR != 354) { printf "expected 353 gate rows, got %d\n", NR - 1 > "/dev/stderr"; failed=1 }; exit failed }
' < <(sed 's/\r$//' -- "$gate_snapshot") || die "route gate failed $mode policy"

diff -u \
  <(awk -F '\t' 'BEGIN { OFS=FS } NR > 1 { print $1, $2 }' < <(sed 's/\r$//' -- "$frozen_snapshot")) \
  <(awk -F '\t' 'BEGIN { OFS=FS } NR > 1 { print $1, $2 }' < <(sed 's/\r$//' -- "$gate_snapshot")) \
  >/dev/null || die 'route gate does not exactly match the frozen method/path contract'

validate_migration() {
  local migration_root kind line evidence_path expected_sha evidence_file actual_sha index
  validate_directory "$(dirname -- "$migration_compatibility")" 'migration manifest controlling directory'
  snapshot_input "$migration_compatibility" "$(dirname -- "$migration_compatibility")" migration.env \
    "$max_evidence_bytes" 'migration compatibility manifest' "${asset_sha[migration-compatibility.env]}"
  migration_snapshot=$SNAPSHOT_RESULT
  mapfile -t migration_fields < <(sed 's/\r$//' -- "$migration_snapshot")
  [[ ${#migration_fields[@]} -eq 6 && ${migration_fields[0]} == 'format=1' &&
    ${migration_fields[1]} == 'migration_state=verified-approved' &&
    ${migration_fields[2]} == "release_revision=$revision" ]] || die 'PostgreSQL migration compatibility is not verified for this release'
  migration_root=$(dirname -- "$migration_compatibility")
  validate_directory "$migration_root" 'migration evidence root'
  declare -gA migration_path=() migration_sha=() migration_snapshot_path=()
  for index in 3 4 5; do
    case $index in 3) kind=schema_contract ;; 4) kind=n_minus_one ;; 5) kind=approval ;; esac
    line=${migration_fields[$index]}
    [[ $line =~ ^$kind=([^@]+)@sha256:([0-9a-f]{64})$ ]] || die "migration compatibility $kind reference is malformed"
    evidence_path=${BASH_REMATCH[1]}; expected_sha=${BASH_REMATCH[2]}
    evidence_file=$(resolve_evidence "$migration_root" "$evidence_path")
    for existing_kind in "${!migration_path[@]}"; do
      [[ ${migration_path[$existing_kind]} != "$evidence_path" ]] || die 'migration evidence paths must be distinct'
      [[ ${migration_sha[$existing_kind]} != "$expected_sha" ]] || die 'migration evidence bytes must be distinct'
    done
    snapshot_input "$evidence_file" "$migration_root" "migration-$kind.json" "$max_evidence_bytes" \
      "migration $kind evidence" "$expected_sha"
    actual_sha=$(sha256_of "$SNAPSHOT_RESULT")
    migration_path[$kind]=$evidence_path
    migration_sha[$kind]=$actual_sha
    migration_snapshot_path[$kind]=$SNAPSHOT_RESULT
  done

  schema_file=${migration_snapshot_path[schema_contract]}
  n1_file=${migration_snapshot_path[n_minus_one]}
  approval_file=${migration_snapshot_path[approval]}
  jq -e --arg revision "$revision" '
    def valid_sha: type == "string" and test("^[0-9a-f]{64}$") and test("^0{64}$") == false;
    (keys == ["author_identity","kind","release_artifact_sha256","release_revision","schema_sha256","schema_version","status"]) and
    .schema_version == 1 and .kind == "postgres-schema-contract" and .release_revision == $revision and .status == "passed" and
    (.author_identity | type == "string" and length > 0) and (.release_artifact_sha256 | valid_sha) and (.schema_sha256 | valid_sha) and
    .release_artifact_sha256 != .schema_sha256
  ' "$schema_file" >/dev/null || die 'PostgreSQL schema-contract evidence JSON is invalid'
  release_artifact=$(jq -r '.release_artifact_sha256' "$schema_file")
  jq -e --arg revision "$revision" --arg artifact "$release_artifact" '
    def valid_sha: type == "string" and test("^[0-9a-f]{64}$") and test("^0{64}$") == false;
    (keys == ["database_restored","duration_seconds","executor_identity","kind","n_artifact_sha256","n_minus_one_artifact_sha256","n_minus_one_revision","n_revision","passed","release_revision","schema_version","status"]) and
    .schema_version == 1 and .kind == "postgres-n-minus-one" and .release_revision == $revision and .status == "passed" and
    .passed == true and .database_restored == false and (.duration_seconds | type == "number" and floor == . and . >= 600) and
    (.executor_identity | type == "string" and length > 0) and .n_revision == $revision and
    (.n_minus_one_revision | type == "string" and test("^[0-9a-fA-F]{7,64}$")) and .n_minus_one_revision != $revision and
    (.n_artifact_sha256 | valid_sha) and (.n_minus_one_artifact_sha256 | valid_sha) and
    .n_artifact_sha256 == $artifact and .n_artifact_sha256 != .n_minus_one_artifact_sha256
  ' "$n1_file" >/dev/null || die 'PostgreSQL N/N-1 evidence JSON is invalid'
  schema_author=$(jq -r '.author_identity' "$schema_file")
  n1_executor=$(jq -r '.executor_identity' "$n1_file")
  jq -e --arg revision "$revision" --arg schema_author "$schema_author" --arg n1_executor "$n1_executor" \
    --arg schema_sha "${migration_sha[schema_contract]}" --arg n1_sha "${migration_sha[n_minus_one]}" '
    (keys == ["bindings","decision","independent","kind","release_revision","reviewer_identity","schema_version","status"]) and
    .schema_version == 1 and .kind == "postgres-migration-approval" and .release_revision == $revision and
    .status == "approved" and .decision == "approved" and .independent == true and
    (.reviewer_identity | type == "string" and length > 0) and .reviewer_identity != $schema_author and .reviewer_identity != $n1_executor and
    (.bindings | keys == ["n_minus_one_sha256","schema_contract_sha256"]) and
    .bindings.schema_contract_sha256 == $schema_sha and .bindings.n_minus_one_sha256 == $n1_sha
  ' "$approval_file" >/dev/null || die 'PostgreSQL migration approval JSON is invalid'
}

if [[ $mode == activate ]]; then
  validate_migration
fi

route_descriptor="$snapshot_dir/route-descriptor.tsv"
evidence_descriptor="$snapshot_dir/evidence-descriptor.tsv"
: >"$route_descriptor"
: >"$evidence_descriptor"
declare -a route_evidence_files=() route_expected_shas=()
route_evidence_index=0
if awk -F '\t' 'NR > 1 && $8 == "rs" { found=1 } END { exit !found }' "$gate_snapshot"; then
  [[ $revision =~ ^[0-9a-fA-F]{7,64}$ ]] || die 'Rust-owned route evidence requires an exact release revision'
  [[ -n $evidence_root && $evidence_root == /* ]] || die 'Rust-owned route evidence requires an absolute evidence root'
  validate_directory "$evidence_root" 'route evidence root'
fi
while IFS=$'\t' read -r method path _ _ _ _ _ owner _ evidence; do
  [[ $owner == rs ]] || continue
  IFS=';' read -r -a entries <<<"$evidence"
  [[ ${#entries[@]} -eq 5 ]] || die "Rust-owned route requires exactly five evidence entries: $method $path"
  declare -A route_path=() route_sha=()
  for entry in "${entries[@]}"; do
    [[ $entry =~ ^(source|compile|mount|differential|approval)=([^@]+)@sha256:([0-9a-f]{64})$ ]] || \
      die "route evidence entry is malformed: $method $path"
    kind=${BASH_REMATCH[1]}; evidence_path=${BASH_REMATCH[2]}; expected_sha=${BASH_REMATCH[3]}
    [[ ! ${route_path[$kind]+x} ]] || die "route evidence contains a duplicate key: $method $path $kind"
    evidence_file=$(resolve_evidence "$evidence_root" "$evidence_path")
    for existing_kind in "${!route_path[@]}"; do
      [[ ${route_path[$existing_kind]} != "$evidence_path" ]] || die "route evidence paths must be distinct: $method $path"
      [[ ${route_sha[$existing_kind]} != "$expected_sha" ]] || die "route evidence bytes must be distinct: $method $path"
    done
    ((route_evidence_index += 1))
    snapshot_input "$evidence_file" "$evidence_root" "route-$route_evidence_index.json" \
      "$max_evidence_bytes" "route $kind evidence" "$expected_sha"
    route_path[$kind]=$evidence_path
    route_sha[$kind]=$expected_sha
    route_evidence_files+=("$SNAPSHOT_RESULT")
    route_expected_shas+=("$expected_sha")
    printf '%s\t%s\t%s\t%s\t%s\n' "$method" "$path" "$revision" "$kind" "$expected_sha" \
      >>"$evidence_descriptor"
  done
  [[ ${#route_path[@]} -eq 5 ]] || die "route evidence keys are incomplete: $method $path"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$method" "$path" "$revision" \
    "${route_sha[source]}" "${route_sha[compile]}" "${route_sha[mount]}" "${route_sha[differential]}" \
    >>"$route_descriptor"
  unset route_path route_sha
done < <(awk -F '\t' 'NR > 1 { print }' < <(sed 's/\r$//' -- "$gate_snapshot"))

if [[ -n ${LMM_ROUTE_GATE_TEST_SNAPSHOT_READY_FILE:-} ]]; then
  [[ $mode == source && ${LMM_ROUTE_GATE_TEST_MODE:-0} == 1 ]] || die 'snapshot synchronization hook is test-source-only'
  : >"$LMM_ROUTE_GATE_TEST_SNAPSHOT_READY_FILE"
  for _ in {1..1000}; do
    [[ -e ${LMM_ROUTE_GATE_TEST_SNAPSHOT_RELEASE_FILE:-} ]] && break
    sleep 0.01
  done
  [[ -e ${LMM_ROUTE_GATE_TEST_SNAPSHOT_RELEASE_FILE:-} ]] || die 'snapshot synchronization hook timed out'
fi

if ((${#route_evidence_files[@]})); then
  mapfile -d '' -t route_hash_records < <(sha256sum --zero -- "${route_evidence_files[@]}")
  ((${#route_hash_records[@]} == ${#route_evidence_files[@]})) || die 'route evidence checksum output is incomplete'
  for index in "${!route_hash_records[@]}"; do
    actual_sha=${route_hash_records[$index]%% *}
    [[ $actual_sha == "${route_expected_shas[$index]}" ]] || die 'route evidence checksum is stale'
  done
  jq -e -s --rawfile descriptors "$evidence_descriptor" '
    . as $all |
    ($descriptors | split("\n") | map(select(length > 0) | split("\t") | {
      method: .[0], path: .[1], revision: .[2], label: .[3], sha: .[4]
    })) as $expected |
    ($all | length) == ($expected | length) and
    all(range(0; $all | length); . as $index | $all[$index] as $e | $expected[$index] as $d |
      $e.kind == $d.label and $e.method == $d.method and $e.path == $d.path and $e.revision == $d.revision)
  ' "${route_evidence_files[@]}" >/dev/null || die 'route evidence external labels or route bindings are invalid'
  jq -e -s --rawfile descriptors "$route_descriptor" '
    def valid_sha: type == "string" and test("^[0-9a-f]{64}$") and test("^0{64}$") == false;
    . as $all |
    ($descriptors | split("\n") | map(select(length > 0) | split("\t") | {
      method: .[0], path: .[1], revision: .[2], source_sha: .[3], compile_sha: .[4],
      mount_sha: .[5], differential_sha: .[6]
    })) as $expected |
    ($all | length) == ($expected | length * 5) and
    all($expected[];
      . as $d |
      [$all[] | select(.method == $d.method and .path == $d.path and .revision == $d.revision)] as $route |
      ($route | length) == 5 and
      ([$route[].kind] | sort) == ["approval","compile","differential","mount","source"] and
      (($route | map({key: .kind, value: .}) | from_entries) as $e |
      ($e.source | keys) == ["author_identity","implementation_sha256","kind","method","path","revision","schema_version","status"] and
      $e.source.schema_version == 1 and $e.source.status == "verified" and
      ($e.source.author_identity | type == "string" and length > 0) and ($e.source.implementation_sha256 | valid_sha) and
      ($e.compile | keys) == ["artifact_sha256","command_sha256","compiler","kind","method","path","revision","schema_version","status"] and
      $e.compile.schema_version == 1 and $e.compile.status == "passed" and
      ($e.compile.compiler | type == "string" and length > 0) and ($e.compile.artifact_sha256 | valid_sha) and
      ($e.compile.command_sha256 | valid_sha) and $e.compile.artifact_sha256 != $e.compile.command_sha256 and
      ($e.mount | keys) == ["kind","listener","method","path","revision","route_count","router_path","router_sha256","schema_version","status"] and
      $e.mount.schema_version == 1 and $e.mount.status == "verified" and
      ($e.mount.listener | type == "string" and length > 0) and
      ($e.mount.route_count | type == "number" and floor == . and . >= 1) and
      ($e.mount.router_path | type == "string" and length > 0 and startswith("/") == false and contains("..") == false) and
      ($e.mount.router_sha256 | valid_sha) and
      ($e.differential | keys) == ["cases","kind","method","passed","path","revision","schema_version","status","transcript_sha256"] and
      $e.differential.schema_version == 1 and $e.differential.status == "passed" and $e.differential.passed == true and
      ($e.differential.cases | type == "number" and floor == . and . > 0) and ($e.differential.transcript_sha256 | valid_sha) and
      ($e.approval | keys) == ["bindings","decision","independent","kind","method","path","reviewer_identity","revision","schema_version","status"] and
      $e.approval.schema_version == 1 and $e.approval.status == "approved" and $e.approval.decision == "approved" and
      $e.approval.independent == true and ($e.approval.reviewer_identity | type == "string" and length > 0) and
      $e.approval.reviewer_identity != $e.source.author_identity and
      ($e.approval.bindings | keys) == ["compile_sha256","differential_sha256","mount_sha256","source_sha256"] and
      $e.approval.bindings.source_sha256 == $d.source_sha and
      $e.approval.bindings.compile_sha256 == $d.compile_sha and
      $e.approval.bindings.mount_sha256 == $d.mount_sha and
      $e.approval.bindings.differential_sha256 == $d.differential_sha)
    )
  ' "${route_evidence_files[@]}" >/dev/null || die 'route evidence JSON semantics or approval bindings are invalid'
fi
