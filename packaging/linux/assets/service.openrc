#!/sbin/openrc-run
name="@PACKAGE@"
description="@PACKAGE@ (preview)"
command="/usr/bin/@PACKAGE@"
command_args="--config /etc/lmm.conf.d/@COMPONENT@.toml"
command_user="@PACKAGE@:@PACKAGE@"
command_background=true
pidfile="/run/lmm/@COMPONENT@/service.pid"
directory="/var/lib/lmm/@COMPONENT@"
retry="TERM/1800"
umask=0077

depend() {
    need net
}

start_pre() {
    checkpath --directory --mode 0755 --owner root:root /run/lmm /var/lib/lmm
    checkpath --directory --mode 0700 --owner @PACKAGE@:@PACKAGE@ \
        /run/lmm/@COMPONENT@ /var/lib/lmm/@COMPONENT@
}
