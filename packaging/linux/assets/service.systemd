[Unit]
Description=@PACKAGE@ (preview)
Documentation=https://github.com/TokenNotIncluded/api.lmm.best
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=@PACKAGE@
Group=@PACKAGE@
StateDirectory=lmm/@COMPONENT@
StateDirectoryMode=0700
RuntimeDirectory=lmm/@COMPONENT@
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/lmm/@COMPONENT@
ExecStart=/usr/bin/@PACKAGE@ --config /etc/lmm.conf.d/@COMPONENT@.toml
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=30min
SendSIGKILL=no
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=@MEMORY@
TasksMax=64

[Install]
WantedBy=multi-user.target
