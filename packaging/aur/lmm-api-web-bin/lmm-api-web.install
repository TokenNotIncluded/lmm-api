post_install() {
  if [ -x /usr/bin/lmm-api-deploy ]; then
    /usr/bin/lmm-api-deploy frontend package-activate --package-version "$1" --keep 10
  else
    /usr/bin/lmm-api deploy frontend package-activate --package-version "$1" --keep 10
  fi
}

post_upgrade() {
  if [ -x /usr/bin/lmm-api-deploy ]; then
    /usr/bin/lmm-api-deploy frontend package-activate --package-version "$1" --keep 10
  else
    /usr/bin/lmm-api deploy frontend package-activate --package-version "$1" --keep 10
  fi
}

post_remove() {
  printf '%s\n' 'The active LMM frontend release was retained for explicit manual rollback.'
}
