# Copy to .env and replace every blank secret. No credential is shipped by default.

# Go is the stable/default backend. SQL_DSN must be PostgreSQL and
# REDIS_CONN_STRING must point to Valkey. URL-encode reserved characters in
# credentials.
SQL_DSN=
REDIS_CONN_STRING=
# Emergency-only bypass for the Go startup BIGINT wallet schema check. Leave
# false unless a separately verified manual migration plan requires a bypass.
SKIP_64BIT_QUOTA_SCHEMA_CHECK=false
SESSION_SECRET=
CRYPTO_SECRET=
# Optional purpose-specific key for HeroSMS credentials and activation data.
# Use at least 32 random bytes; when unset, an explicit CRYPTO_SECRET is used.
HERO_SMS_ENCRYPTION_KEY=

LMM_API_BIND_ADDRESS=127.0.0.1
LMM_API_PORT=3000
# Leave blank for the current single-instance service. A future slot-managed
# unit must set a unique `blue` or `green` value; any non-empty slot requires
# PostgreSQL advisory-lock leadership and gets a distinct heartbeat identity.
LMM_API_INSTANCE_SLOT=
# Must stay below the package-owned systemd TimeoutStopSec=45s. Runtime clamps
# larger or non-positive values to the safe 30-40 second process budget.
SHUTDOWN_TIMEOUT_SECONDS=30
# Optional public origin used by the Go backend when the database
# ServerAddress option is empty. Set an explicit HTTPS origin before enabling
# OAuth or external callbacks; it is intentionally blank by default.
SERVER_ADDRESS=
# Optional diagnostics. pprof is disabled by default and binds loopback when enabled.
ENABLE_PPROF=false
PPROF_BIND_ADDRESS=127.0.0.1
PPROF_PORT=8005
LMM_IMAGE_TAG=local
TZ=Asia/Shanghai

# Provider-specific package templates live under packaging/common. Production
# enters either backend through the package-verified /usr/bin/lmm-api symlink;
# do not duplicate secret values across provider-specific files.

# Resource bounds for asynchronous provider polling and scheduler history.
# Lower TASK_POLLING_CONCURRENCY on small hosts; terminal task rows are kept
# per type while pending/running work is never pruned.
TASK_POLLING_CONCURRENCY=8
SYSTEM_TASK_HISTORY_KEEP=100

# Waffo Pancake test credentials. The Go backend uses the official server-side
# SDK; never expose the private key to the Web bundle or commit either value.
# WAFFO_MERCHANT_ID is the Merchant ID shown at the top of Dashboard → API & Development,
# not a storeId. The first checkout integration needs only these two variables.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
