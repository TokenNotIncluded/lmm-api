# Copy to .env and replace every blank secret. No credential is shipped by default.
POSTGRES_DB=lmm_api
POSTGRES_USER=lmm_api
POSTGRES_PASSWORD=

# Go is the stable/default backend. SQL_DSN must be PostgreSQL; VALKEY_URL must
# point to the Valkey service. URL-encode reserved characters in credentials.
SQL_DSN=
VALKEY_PASSWORD=
VALKEY_URL=
SESSION_SECRET=
CRYPTO_SECRET=

LMM_API_BIND_ADDRESS=127.0.0.1
LMM_API_PORT=3000
# Optional public origin used by the Go backend when the database
# ServerAddress option is empty. Set an explicit HTTPS origin before enabling
# OAuth or external callbacks; it is intentionally blank by default.
SERVER_ADDRESS=
# Optional diagnostics. pprof is disabled by default and binds loopback when enabled.
ENABLE_PPROF=false
PPROF_BIND_ADDRESS=127.0.0.1
PPROF_PORT=8005
LMM_IMAGE_TAG=local
TZ=Asia/Shanghai

# Rust is opt-in only. Restore or supply a preview stack before enabling these settings.
# Use a dedicated preview database/schema. The Compose guard rejects schemas
# that do not start with lmm_preview_. Never point this URL at production data.
LMM_RS_PREVIEW_DATABASE_URL=
LMM_RS_PREVIEW_VALKEY_URL=
LMM_RS_PREVIEW_SCHEMA=lmm_preview_v1
LMM_RS_PREVIEW_SCHEMA_CONTRACT=1
LMM_RS_PREVIEW_BIND_ADDRESS=127.0.0.1
LMM_RS_PREVIEW_PORT=3001
LMM_BUILD_REVISION=development

# Waffo Pancake test credentials. The Go backend uses the official server-side
# SDK; never expose the private key to the Web bundle or commit either value.
# WAFFO_MERCHANT_ID is the Merchant ID shown at the top of Dashboard → API & Development,
# not a storeId. The first checkout integration needs only these two variables.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=

# Open-source bounty MCP client settings. Keep the personal token secret.
OPEN_SOURCE_BOUNTY_MCP_ENDPOINT=https://api.lmm.best/mcp
OPEN_SOURCE_BOUNTY_MCP_PROTOCOL=2026-07-28
OPEN_SOURCE_BOUNTY_MCP_TOKEN=
