# Fresh-install WIP: Go extension process only.
# Copy to a private local file and export the values before starting Go.
# The program does not auto-load .env. Never source a production environment here.
LMM_EXTENSION_LISTEN=127.0.0.1:8081
LMM_EXTENSION_TOKEN_FILE=
# Explicit module selection. Use identity only after configuring both RPC values.
LMM_EXTENSION_MODULES=none
LMM_CORE_RPC_SOCKET=
LMM_CORE_RPC_TOKEN_FILE=
# The Rust database belongs only to the core process. See deployment/docker/README.md.
# Do not put core database credentials or old single-server settings in this file.

# Optional public policy snapshot; leave empty until reviewed. No core access.
LMM_LEGAL_CONFIG_FILE=
