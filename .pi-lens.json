{
  "ignore": [
    "**/.git/**",
    "**/.memsearch/**",
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/*.map"
  ],
  "rules": {
    "framework-and-toolchain-policy": {
      "disable": [
        "jscpd:duplicate",
        "go-ignored-call-result",
        "go-bare-error",
        "go-context-background-handler",
        "go-goroutine-loop-capture",
        "go-time-sleep-test",
        "find-import-file-without-extension",
        "go-path-traversal",
        "go-hardcoded-secrets",
        "rust-expect",
        "rust-unwrap",
        "no-runtime-typeof",
        "no-unknown-parameters",
        "no-unsafe-dictionary-unknown",
        "no-conditional-empty-object-spread",
        "no-known-value-widening",
        "inline-styles",
        "nested-ternary",
        "ts-double-negation",
        "ts-redundant-filter-map",
        "go-test-functions",
        "go-direct-panic",
        "console-statement",
        "no-console-except-error",
        "ts-delete-property",
        "pass-through-wrappers",
        "no-any-type",
        "no-as-any",
        "no-extra-boolean-cast",
        "ts-parseint-no-radix",
        "redundant-usestate-type",
        "async-noise",
        "mixed-async-styles",
        "require-await",
        "async-unnecessary-wrapper",
        "no-return-await",
        "unnecessary-react-hook",
        "ts-unnecessary-else-return",
        "switch-without-default",
        "prefer-dom-node-append",
        "redundant-state",
        "ts-string-split-index",
        "ts-json-stringify-parse",
        "prefer-structured-clone",
        "prefer-number-properties",
        "no-relative-cross-package-import",
        "prefer-query-selector",
        "prefer-string-slice",
        "prefer-optional-chain",
        "deep-promise-chain",
        "gorm-n-plus-one",
        "shellcheck:SC2034",
        "shellcheck:SC2016",
        "shellcheck:SC2329",
        "shellcheck:SC2318",
        "typos",
        "typos:unknown",
        "knip:file",
        "knip:export",
        "knip:devDependency",
        "knip:dependency",
        "knip:unlisted",
        "inactive-code"
      ]
    },
    "architecture-advisories": {
      "disable": [
        "high-complexity",
        "high-fan-out",
        "high-import-coupling",
        "long-parameter-list",
        "large-class",
        "no-shape-in-symbol-names",
        "no-flag-argument",
        "deep-nesting"
      ]
    }
  },
  "maxProjectFiles": 5000
}
