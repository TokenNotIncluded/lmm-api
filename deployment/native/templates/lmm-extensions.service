# Optional /opt store only. ArchDmit uses the packaged /usr/bin service instead.
[Unit]
Description=LMM Extensions (operator reviewed native candidate)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=lmm-extensions
Group=lmm-extensions
SupplementaryGroups=lmm-rpc
StateDirectory=lmm/extensions
StateDirectoryMode=0700
RuntimeDirectory=lmm/extensions
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/lmm/extensions
ExecStart=/opt/lmm/current/extensions/bin/lmm-extensions --config /etc/lmm.conf.d/extensions.toml
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=30min
SendSIGKILL=no
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
