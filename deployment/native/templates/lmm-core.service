# Optional /opt store only. ArchDmit uses the packaged /usr/bin service instead.
[Unit]
Description=LMM Core (operator reviewed native candidate)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=lmm-core
Group=lmm-rpc
StateDirectory=lmm/core
StateDirectoryMode=0700
RuntimeDirectory=lmm/core
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/lmm/core
ExecStart=/opt/lmm/current/core/bin/lmm-core --config /etc/lmm.conf.d/core.toml
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=30min
SendSIGKILL=no
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
